# frontend/.env.example
# Copy to frontend/.env.local (git-ignored) and fill in your values.
#
# Vite only exposes variables prefixed with VITE_ to the browser.

# Google OAuth — paste the same Client ID you set in the backend's
# GOOGLE_OAUTH_CLIENT_ID. Leave blank to hide the "Sign in with Google"
# button; email/password login still works.
VITE_GOOGLE_CLIENT_ID=
